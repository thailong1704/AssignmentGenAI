# ---- X (Twitter) API - from your app at console.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/callback

# ---- OpenAI - scoring + drafting
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# USD per 1M tokens for the model above (used for the cost display)
OPENAI_PRICE_IN=0.40
OPENAI_PRICE_OUT=1.60

# ---- Modes
# DRY_RUN=1 -> no calls to X, fictional data from fixtures.json, nothing sent or billed.
# Defaults to 1 when X_CLIENT_ID is empty.
DRY_RUN=1
# In DRY_RUN, use the real OpenAI model on the fictional data? 0 = yes (costs a few cents)
LLM_DRY_RUN=1

# ---- Targeting & drafting
MIN_FIT_SCORE=6
POSTS_PER_PERSON=15
SENDER_NAME=
SENDER_CONTEXT=GenAI Fund builds AI ecosystems in Southeast Asia: we back and connect AI and robotics founders, builders and researchers in the region.

# ---- Display
# Hours from UTC for times shown in the app (7 = GMT+7, Vietnam/Thailand/Indonesia-West)
DISPLAY_UTC_OFFSET=7
